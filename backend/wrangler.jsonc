{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "backend",
	"main": "src/index.ts",
	"compatibility_date": "2025-06-01",
	"d1_databases": [
		{
			"binding": "DB",
			"database_id": "de9a3ec7-792c-4400-b755-8c4a985f75a1",
			"database_name": "mediabox"
		}
	],
	"vars": {
		"HF_BACKEND_URL": "https://evro90-nm6.hf.space"
	}
	// СЕКРЕТЫ больше не хранятся в конфиге (plaintext ADMIN_API_KEY утёк в git).
	// Перед деплоем выполнить РОТАЦИЮ ключей и установить их как секреты Worker:
	//   npx wrangler secret put ADMIN_API_KEY   (новое значение!)
	//   npx wrangler secret put TMDB_API_KEY
	// Код читает их через env binding — имя переменной не менялось.
	// To create the D1 database, run:
	// npx wrangler d1 create mediabox
	// Then replace YOUR_D1_DATABASE_ID with the returned ID
	//
	// To create the KV namespace, run:
	// npx wrangler kv namespace create CACHE
}